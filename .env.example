# Name of the organization created on first seed/start (optional).
ORGANIZATION_NAME=

POSTGRES_DB=arcadiaone
POSTGRES_USER=arcadiaone
POSTGRES_PASSWORD=replace-with-a-strong-password
DATABASE_URL=postgresql://arcadiaone:replace-with-a-strong-password@postgres:5432/arcadiaone

# Generate with: openssl rand -base64 48
AUTH_SECRET=replace-with-at-least-32-random-bytes
# Set only while running `npm run db:bootstrap-admin`; do not retain real values here.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-temporary-passphrase
# Optional existing employee UUID:
BOOTSTRAP_ADMIN_EMPLOYEE_ID=

# Uploaded binaries live outside the image on the dedicated document-data volume.
DOCUMENT_STORAGE_PATH=/data/documents
DOCUMENT_MAX_UPLOAD_BYTES=26214400

# E-signature provider configuration. LOCAL is workflow-only and makes no legal claim.
SIGNATURE_PROVIDER=LOCAL
SIGNATURE_API_BASE_URL=
SIGNATURE_API_KEY=
SIGNATURE_WEBHOOK_SECRET=replace-with-a-dedicated-random-secret
SIGNATURE_SENDER_IDENTITY=
SIGNATURE_DEFAULT_EXPIRATION_DAYS=30

# Minutes between scheduled reminder evaluations by the `worker` service (default 15).
# The checks are idempotent, so the interval only affects how quickly a reminder appears.
NOTIFICATION_JOB_INTERVAL_MINUTES=15
