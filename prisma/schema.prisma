/// A logical, versioned document. Binary data is held only by DocumentVersion.
model DocumentCategory {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  description    String?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  documents      Document[]

  @@unique([organizationId, name])
  @@index([organizationId, active])
}

model Document {
  id                String                  @id @default(uuid())
  organizationId    String
  title             String
  description       String?
  categoryId        String?
  status            DocumentStatus          @default(ACTIVE)
  sensitivity       DocumentSensitivity     @default(NORMAL)
  currentVersionId  String?                 @unique
  createdByUserId   String
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  archivedAt        DateTime?
  organization      Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  category          DocumentCategory?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy         User                    @relation("DocumentCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  currentVersion    DocumentVersion?        @relation("CurrentDocumentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions          DocumentVersion[]       @relation("DocumentVersions")
  relations         DocumentRelation[]
  activities        DocumentActivity[]
  signatureRequests SignatureRequest[]      @relation("SignatureSourceDocument")
  signedResults     SignatureRequest[]      @relation("SignatureSignedDocument")
  invoiceDocuments  Invoice[]               @relation("InvoiceDocument")
  portalShares      DocumentPortalShare[]
  approvalRequests  ClientApprovalRequest[]

  @@index([organizationId, status, updatedAt])
  @@index([organizationId, categoryId])
  @@index([organizationId, title])
}

model DocumentVersion {
  id                 String             @id @default(uuid())
  organizationId     String
  documentId         String
  versionNumber      Int
  originalFilename   String
  storageKey         String
  mimeType           String
  sizeBytes          Int
  checksum           String
  uploadedByUserId   String
  uploadedAt         DateTime           @default(now())
  notes              String?
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  document           Document           @relation("DocumentVersions", fields: [documentId], references: [id], onDelete: Cascade)
  currentForDocument Document?          @relation("CurrentDocumentVersion")
  uploadedBy         User               @relation("DocumentVersionUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  signatureRequests  SignatureRequest[]

  @@unique([documentId, versionNumber])
  @@unique([organizationId, storageKey])
  @@index([organizationId, documentId])
}

/// Explicit nullable foreign keys keep attachment targets type-safe and auditable.
/// Application validation requires exactly one target and verifies its organization.
model DocumentRelation {
  id                      String                  @id @default(uuid())
  organizationId          String
  documentId              String
  employeeId              String?
  employeeQualificationId String?
  projectId               String?
  taskId                  String?
  clientId                String?
  rentalId                String?
  equipmentId             String?
  createdAt               DateTime                @default(now())
  organization            Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  document                Document                @relation(fields: [documentId], references: [id], onDelete: Cascade)
  employee                Employee?               @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeQualification   EmployeeQualification?  @relation(fields: [employeeQualificationId], references: [id], onDelete: Cascade)
  project                 Project?                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task                    Task?                   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  client                  Client?                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  rental                  Rental?                 @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  equipment               Equipment?              @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  trainingCourseId        String?
  trainingSessionId       String?
  trainingRecordId        String?
  maintenanceRecordId     String?
  trainingCourse          TrainingCourse?         @relation(fields: [trainingCourseId], references: [id], onDelete: Cascade)
  trainingSession         TrainingSession?        @relation(fields: [trainingSessionId], references: [id], onDelete: Cascade)
  trainingRecord          EmployeeTrainingRecord? @relation(fields: [trainingRecordId], references: [id], onDelete: Cascade)
  maintenanceRecord       MaintenanceRecord?      @relation(fields: [maintenanceRecordId], references: [id], onDelete: Cascade)

  @@index([organizationId, documentId])
  @@index([organizationId, employeeId])
  @@index([organizationId, employeeQualificationId])
  @@index([organizationId, projectId])
  @@index([organizationId, taskId])
  @@index([organizationId, clientId])
  @@index([organizationId, rentalId])
  @@index([organizationId, equipmentId])
  @@index([organizationId, trainingRecordId])
  @@index([organizationId, trainingSessionId])
  @@index([organizationId, maintenanceRecordId])
}

model DocumentActivity {
