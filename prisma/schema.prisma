generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model SystemHealth {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
}

model Organization {
  id                String             @id @default(uuid())
  name              String             @unique
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  departments       Department[]
  positions         Position[]
  employees         Employee[]
  projects          Project[]
  projectMembers    ProjectMember[]
  projectRoles      ProjectRole[]
  projectMilestones ProjectMilestone[]
  projectActivities ProjectActivity[]
}

model Department {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  description    String?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employees      Employee[]

  @@unique([organizationId, name])
  @@index([organizationId, active])
}

model Position {
  id             String       @id @default(uuid())
  organizationId String
  title          String
  description    String?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employees      Employee[]

  @@unique([organizationId, title])
  @@index([organizationId, active])
}

model Employee {
  id                 String           @id @default(uuid())
  organizationId     String
  employeeNumber     String?
  firstName          String
  preferredName      String?
  middleName         String?
  lastName           String
  suffix             String?
  workEmail          String?
  personalEmail      String?
  workPhone          String?
  mobilePhone        String?
  departmentId       String?
  positionId         String?
  supervisorId       String?
  employmentStatus   EmploymentStatus @default(ACTIVE)
  hireDate           DateTime?
  separationDate     DateTime?
  notes              String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  department         Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  position           Position?        @relation(fields: [positionId], references: [id], onDelete: SetNull)
  supervisor         Employee?        @relation("EmployeeSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  directReports      Employee[]       @relation("EmployeeSupervisor")
  managedProjects    Project[]        @relation("ProjectManager")
  projectMemberships ProjectMember[]

  @@unique([organizationId, employeeNumber])
  @@index([organizationId, employmentStatus])
  @@index([departmentId])
  @@index([positionId])
  @@index([supervisorId])
  @@index([lastName, firstName])
}

model Project {
  id               String             @id @default(uuid())
  organizationId   String
  projectNumber    String?
  name             String
  description      String?
  status           ProjectStatus      @default(PLANNING)
  priority         ProjectPriority    @default(NORMAL)
  startDate        DateTime?
  targetEndDate    DateTime?
  actualEndDate    DateTime?
  projectManagerId String?
  clientName       String?
  location         String?
  notes            String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  projectManager   Employee?          @relation("ProjectManager", fields: [projectManagerId], references: [id], onDelete: SetNull)
  members          ProjectMember[]
  milestones       ProjectMilestone[]
  activities       ProjectActivity[]

  @@unique([organizationId, projectNumber])
  @@index([organizationId, status])
  @@index([organizationId, projectManagerId])
  @@index([organizationId, name])
}

model ProjectRole {
  id             String          @id @default(uuid())
  organizationId String
  name           String
  description    String?
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  members        ProjectMember[]

  @@unique([organizationId, name])
  @@index([organizationId, active])
}

model ProjectMember {
  id             String       @id @default(uuid())
  organizationId String
  projectId      String
  employeeId     String
  projectRoleId  String?
  joinedAt       DateTime?
  leftAt         DateTime?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  projectRole    ProjectRole? @relation(fields: [projectRoleId], references: [id], onDelete: SetNull)

  // One durable membership per employee keeps history while leftAt marks it ended.
  @@unique([projectId, employeeId])
  @@index([organizationId, employeeId])
}

model ProjectMilestone {
  id             String          @id @default(uuid())
  organizationId String
  projectId      String
  name           String
  description    String?
  targetDate     DateTime?
  completedAt    DateTime?
  status         MilestoneStatus @default(PENDING)
  sortOrder      Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([organizationId, projectId, sortOrder])
  @@index([organizationId, status, targetDate])
}

model ProjectActivity {
  id             String              @id @default(uuid())
  organizationId String
  projectId      String
  type           ProjectActivityType @default(NOTE)
  content        String
  createdAt      DateTime            @default(now())
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project        Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([organizationId, projectId, createdAt])
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
  LEAVE
  TERMINATED
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum ProjectPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProjectActivityType {
  NOTE
  SYSTEM
}
