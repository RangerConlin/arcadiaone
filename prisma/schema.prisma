generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model SystemHealth {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
}

model Organization {
  id                                     String                             @id @default(uuid())
  name                                   String                             @unique
  createdAt                              DateTime                           @default(now())
  updatedAt                              DateTime                           @updatedAt
  departments                            Department[]
  positions                              Position[]
  employees                              Employee[]
  qualificationTypes                     QualificationType[]
  employeeQualifications                 EmployeeQualification[]
  qualificationDocuments                 QualificationDocument[]
  positionQualificationRequirements      PositionQualificationRequirement[]
  users                                  User[]
  projects                               Project[]
  projectMembers                         ProjectMember[]
  projectRoles                           ProjectRole[]
  projectMilestones                      ProjectMilestone[]
  projectActivities                      ProjectActivity[]
  tasks                                  Task[]
  taskComments                           TaskComment[]
  taskActivities                         TaskActivity[]
  clients                                Client[]
  clientContacts                         ClientContact[]
  clientActivities                       ClientActivity[]
  equipmentCategories                    EquipmentCategory[]
  equipmentLocations                     EquipmentLocation[]
  equipment                              Equipment[]
  rentals                                Rental[]
  rentalActivities                       RentalActivity[]
  equipmentPackages                      EquipmentPackage[]
  qualificationExpirationWarningDays     Int                                @default(60)
  documentCategories                     DocumentCategory[]
  documents                              Document[]
  documentVersions                       DocumentVersion[]
  documentRelations                      DocumentRelation[]
  documentActivities                     DocumentActivity[]
  invoices                               Invoice[]
  invoiceLineItems                       InvoiceLineItem[]
  payments                               Payment[]
  invoiceActivities                      InvoiceActivity[]
  signatureRequests                      SignatureRequest[]
  signatureSigners                       SignatureSigner[]
  signatureEvents                        SignatureEvent[]
  clientPortalUsers                      ClientPortalUser[]
  clientPortalInvitations                ClientPortalInvitation[]
  documentPortalShares                   DocumentPortalShare[]
  clientApprovalRequests                 ClientApprovalRequest[]
  portalActivities                       PortalActivity[]
  invoicePrefix                          String                             @default("INV-")
  nextInvoiceSequence                    Int                                @default(1)
  defaultCurrency                        String                             @default("USD")
  defaultPaymentTerms                    String?
  invoiceFooter                          String?
  billingAddress                         String?
  timezone                               String                             @default("UTC")
  taskDueSoonDays                        Int                                @default(7)
  rentalDueSoonDays                      Int                                @default(3)
  invoiceDueSoonDays                     Int                                @default(7)
  notificationArchiveAfterDays           Int                                @default(90)
  calendarEvents                         CalendarEvent[]
  notifications                          Notification[]
  notificationPreferences                NotificationPreference[]
  nextLedgerSequence                     Int                                @default(1)
  autoPostPaymentsToLedger               Boolean                            @default(true)
  ledgerCategories                       LedgerCategory[]
  ledgerTransactions                     LedgerTransaction[]
  auditEvents                            AuditEvent[]
  savedReportFilters                     SavedReportFilter[]
  allowTrainingSelfEnrollment            Boolean                            @default(true)
  managersCanVerifyTraining              Boolean                            @default(false)
  allowVerifiedQualificationFromTraining Boolean                            @default(false)
  trainingSessionReminderDays            Int                                @default(2)
  managersCanManageMaintenance           Boolean                            @default(true)
  employeesCanReportMaintenance          Boolean                            @default(true)
  maintenanceDueSoonDays                 Int                                @default(14)
  maintenanceMeterWarningPercent         Int                                @default(10)
  autoPostMaintenanceCostToLedger        Boolean                            @default(false)
  trainingCourses                        TrainingCourse[]
  trainingCourseQualifications           TrainingCourseQualification[]
  trainingSessions                       TrainingSession[]
  trainingEnrollments                    TrainingEnrollment[]
  employeeTrainingRecords                EmployeeTrainingRecord[]
  maintenanceRecords                     MaintenanceRecord[]
  maintenanceSchedules                   MaintenanceSchedule[]
  meterReadings                          MeterReading[]
}

model Department {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  description    String?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employees      Employee[]

  @@unique([organizationId, name])
  @@index([organizationId, active])
}

model Position {
  id                        String                             @id @default(uuid())
  organizationId            String
  title                     String
  description               String?
  active                    Boolean                            @default(true)
  createdAt                 DateTime                           @default(now())
  updatedAt                 DateTime                           @updatedAt
  organization              Organization                       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employees                 Employee[]
  qualificationRequirements PositionQualificationRequirement[]

  @@unique([organizationId, title])
  @@index([organizationId, active])
}

model Employee {
  id                   String                   @id @default(uuid())
  organizationId       String
  employeeNumber       String?
  firstName            String
  preferredName        String?
  middleName           String?
  lastName             String
  suffix               String?
  workEmail            String?
  personalEmail        String?
  workPhone            String?
  mobilePhone          String?
  departmentId         String?
  positionId           String?
  supervisorId         String?
  employmentStatus     EmploymentStatus         @default(ACTIVE)
  hireDate             DateTime?
  separationDate       DateTime?
  notes                String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  organization         Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  department           Department?              @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  position             Position?                @relation(fields: [positionId], references: [id], onDelete: SetNull)
  supervisor           Employee?                @relation("EmployeeSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  directReports        Employee[]               @relation("EmployeeSupervisor")
  qualifications       EmployeeQualification[]
  user                 User?
  managedProjects      Project[]                @relation("ProjectManager")
  projectMemberships   ProjectMember[]
  assignedTasks        Task[]                   @relation("TaskAssignee")
  preparedRentals      Rental[]                 @relation("RentalPreparer")
  checkedOutRentals    Rental[]                 @relation("RentalCheckoutEmployee")
  receivedRentals      Rental[]                 @relation("RentalReceiver")
  documentRelations    DocumentRelation[]
  signatureSigners     SignatureSigner[]
  calendarEvents       CalendarEvent[]
  trainingEnrollments  TrainingEnrollment[]
  trainingRecords      EmployeeTrainingRecord[]
  performedMaintenance MaintenanceRecord[]
  responsibleSchedules MaintenanceSchedule[]

  @@unique([organizationId, employeeNumber])
  @@index([organizationId, employmentStatus])
  @@index([departmentId])
  @@index([positionId])
  @@index([supervisorId])
  @@index([lastName, firstName])
}

model Project {
  id                 String                  @id @default(uuid())
  organizationId     String
  projectNumber      String?
  name               String
  description        String?
  status             ProjectStatus           @default(PLANNING)
  priority           ProjectPriority         @default(NORMAL)
  startDate          DateTime?
  targetEndDate      DateTime?
  actualEndDate      DateTime?
  projectManagerId   String?
  clientName         String?
  clientId           String?
  location           String?
  notes              String?
  portalVisible      Boolean                 @default(false)
  clientDescription  String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  organization       Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  projectManager     Employee?               @relation("ProjectManager", fields: [projectManagerId], references: [id], onDelete: SetNull)
  members            ProjectMember[]
  milestones         ProjectMilestone[]
  activities         ProjectActivity[]
  tasks              Task[]
  client             Client?                 @relation(fields: [clientId], references: [id], onDelete: SetNull)
  rentals            Rental[]
  documentRelations  DocumentRelation[]
  invoices           Invoice[]
  approvalRequests   ClientApprovalRequest[]
  calendarEvents     CalendarEvent[]
  ledgerTransactions LedgerTransaction[]

  @@unique([organizationId, projectNumber])
  @@index([organizationId, status])
  @@index([organizationId, projectManagerId])
  @@index([organizationId, name])
  @@index([organizationId, clientId])
}

model Client {
  id                 String                   @id @default(uuid())
  organizationId     String
  createdByUserId    String
  name               String
  displayName        String?
  clientNumber       String?
  status             ClientStatus             @default(PROSPECT)
  type               ClientType?
  primaryContactId   String?
  website            String?
  mainPhone          String?
  generalEmail       String?
  addressLine1       String?
  addressLine2       String?
  city               String?
  stateProvince      String?
  postalCode         String?
  country            String?
  notes              String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  organization       Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy          User                     @relation("ClientCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  contacts           ClientContact[]          @relation("ClientContacts")
  primaryContact     ClientContact?           @relation("PrimaryClientContact", fields: [primaryContactId], references: [id], onDelete: SetNull)
  projects           Project[]
  activities         ClientActivity[]
  rentals            Rental[]
  documentRelations  DocumentRelation[]
  invoices           Invoice[]
  portalUsers        ClientPortalUser[]
  portalInvitations  ClientPortalInvitation[]
  documentShares     DocumentPortalShare[]
  approvalRequests   ClientApprovalRequest[]
  portalActivities   PortalActivity[]
  calendarEvents     CalendarEvent[]
  ledgerTransactions LedgerTransaction[]

  @@unique([organizationId, clientNumber])
  @@index([organizationId, status, name])
  @@index([createdByUserId])
}

model ClientContact {
  id                     String                   @id @default(uuid())
  organizationId         String
  clientId               String
  firstName              String
  lastName               String
  title                  String?
  email                  String?
  phone                  String?
  mobilePhone            String?
  preferredContactMethod PreferredContactMethod?
  primary                Boolean                  @default(false)
  active                 Boolean                  @default(true)
  notes                  String?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  organization           Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  client                 Client                   @relation("ClientContacts", fields: [clientId], references: [id], onDelete: Cascade)
  primaryFor             Client[]                 @relation("PrimaryClientContact")
  rentals                Rental[]
  signatureSigners       SignatureSigner[]
  portalUser             ClientPortalUser?
  portalInvitations      ClientPortalInvitation[]

  @@index([organizationId, clientId, active])
  @@index([organizationId, lastName, firstName])
}

model ClientActivity {
  id             String             @id @default(uuid())
  organizationId String
  clientId       String
  userId         String
  activityType   ClientActivityType @default(NOTE)
  summary        String
  occurredAt     DateTime           @default(now())
  createdAt      DateTime           @default(now())
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  client         Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user           User               @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([organizationId, clientId, occurredAt])
}

model ProjectMember {
  id             String       @id @default(uuid())
  organizationId String
  projectId      String
  employeeId     String
  projectRoleId  String?
  joinedAt       DateTime?
  leftAt         DateTime?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  projectRole    ProjectRole? @relation(fields: [projectRoleId], references: [id], onDelete: SetNull)

  // One durable membership per employee keeps history while leftAt marks it ended.
  @@unique([projectId, employeeId])
  @@index([organizationId, employeeId])
}

model ProjectMilestone {
  id                String          @id @default(uuid())
  organizationId    String
  projectId         String
  name              String
  description       String?
  portalVisible     Boolean         @default(false)
  clientDescription String?
  targetDate        DateTime?
  completedAt       DateTime?
  status            MilestoneStatus @default(PENDING)
  sortOrder         Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project           Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks             Task[]

  @@index([organizationId, projectId, sortOrder])
  @@index([organizationId, status, targetDate])
}

model ProjectRole {
  id             String          @id @default(uuid())
  organizationId String
  name           String
  description    String?
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  members        ProjectMember[]

  @@unique([organizationId, name])
  @@index([organizationId, active])
}

model ProjectActivity {
  id             String              @id @default(uuid())
  organizationId String
  projectId      String
  type           ProjectActivityType @default(NOTE)
  content        String
  createdAt      DateTime            @default(now())
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project        Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([organizationId, projectId, createdAt])
}

model Task {
  id                   String              @id @default(uuid())
  organizationId       String
  projectId            String?
  parentTaskId         String?
  milestoneId          String?
  title                String
  description          String?
  status               TaskStatus          @default(TODO)
  priority             TaskPriority        @default(NORMAL)
  dueDate              DateTime?
  startDate            DateTime?
  completedAt          DateTime?
  createdByUserId      String
  assignedToEmployeeId String?
  assignedByUserId     String?
  sortOrder            Int                 @default(0)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  organization         Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project              Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  milestone            ProjectMilestone?   @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  parentTask           Task?               @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: SetNull)
  subtasks             Task[]              @relation("TaskSubtasks")
  createdBy            User                @relation("TaskCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  assignedTo           Employee?           @relation("TaskAssignee", fields: [assignedToEmployeeId], references: [id], onDelete: SetNull)
  assignedBy           User?               @relation("TaskAssigner", fields: [assignedByUserId], references: [id], onDelete: SetNull)
  checklistItems       TaskChecklistItem[]
  comments             TaskComment[]
  activities           TaskActivity[]
  documentRelations    DocumentRelation[]

  @@index([organizationId, status, dueDate])
  @@index([organizationId, assignedToEmployeeId, status])
  @@index([organizationId, completedAt])
  @@index([projectId, status])
  @@index([milestoneId])
  @@index([parentTaskId])
}

model TaskChecklistItem {
  id        String   @id @default(uuid())
  taskId    String
  text      String
  completed Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, sortOrder])
}

model TaskComment {
  id             String       @id @default(uuid())
  organizationId String
  taskId         String
  userId         String
  content        String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  task           Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([organizationId, taskId, createdAt])
}

model TaskActivity {
  id             String           @id @default(uuid())
  organizationId String
  taskId         String
  userId         String
  type           TaskActivityType
  detail         String?
  createdAt      DateTime         @default(now())
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  task           Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([organizationId, taskId, createdAt])
}

model QualificationType {
  id                       String                             @id @default(uuid())
  organizationId           String
  name                     String
  abbreviation             String?
  description              String?
  category                 QualificationCategory
  issuingOrganization      String?
  expirationBehavior       ExpirationBehavior                 @default(DOES_NOT_EXPIRE)
  defaultValidityMonths    Int?
  credentialNumberExpected Boolean                            @default(false)
  documentExpected         Boolean                            @default(false)
  active                   Boolean                            @default(true)
  createdAt                DateTime                           @default(now())
  updatedAt                DateTime                           @updatedAt
  organization             Organization                       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employeeQualifications   EmployeeQualification[]
  positionRequirements     PositionQualificationRequirement[]
  trainingCourseLinks      TrainingCourseQualification[]

  @@unique([organizationId, name])
  @@index([organizationId, active])
}

model EmployeeQualification {
  id                  String                   @id @default(uuid())
  organizationId      String
  employeeId          String
  qualificationTypeId String
  credentialNumber    String?
  issuingOrganization String?
  issueDate           DateTime?
  expirationDate      DateTime?
  verificationStatus  VerificationStatus       @default(UNVERIFIED)
  verifiedAt          DateTime?
  verifiedByUserId    String?
  verificationNote    String?
  notes               String?
  archivedAt          DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  organization        Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee            Employee                 @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  qualificationType   QualificationType        @relation(fields: [qualificationTypeId], references: [id], onDelete: Restrict)
  documents           QualificationDocument[]
  documentRelations   DocumentRelation[]
  trainingEnrollments TrainingEnrollment[]
  trainingRecords     EmployeeTrainingRecord[]

  @@index([organizationId, expirationDate])
  @@index([employeeId, qualificationTypeId])
  @@index([organizationId, verificationStatus])
}

model QualificationDocument {
  id                      String                @id @default(uuid())
  organizationId          String
  employeeQualificationId String
  originalFilename        String
  storageKey              String
  mimeType                String
  sizeBytes               Int
  uploadedAt              DateTime              @default(now())
  uploadedByUserId        String?
  organization            Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employeeQualification   EmployeeQualification @relation(fields: [employeeQualificationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, storageKey])
  @@index([employeeQualificationId])
}

model PositionQualificationRequirement {
  id                  String            @id @default(uuid())
  organizationId      String
  positionId          String
  qualificationTypeId String
  required            Boolean           @default(true)
  notes               String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  organization        Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  position            Position          @relation(fields: [positionId], references: [id], onDelete: Cascade)
  qualificationType   QualificationType @relation(fields: [qualificationTypeId], references: [id], onDelete: Restrict)

  @@unique([positionId, qualificationTypeId])
  @@index([organizationId, qualificationTypeId])
}

enum QualificationCategory {
  CERTIFICATION
  LICENSE
  QUALIFICATION
  AUTHORIZATION
  INTERNAL
}

enum ExpirationBehavior {
  DOES_NOT_EXPIRE
  TRACKED
  CALCULATED
}

enum VerificationStatus {
  UNVERIFIED
  VERIFIED
  REJECTED
}

model User {
  id                        String                   @id @default(uuid())
  organizationId            String
  employeeId                String?                  @unique
  email                     String
  passwordHash              String
  role                      UserRole                 @default(EMPLOYEE)
  active                    Boolean                  @default(true)
  mustChangePassword        Boolean                  @default(true)
  lastLoginAt               DateTime?
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  organization              Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee                  Employee?                @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  sessions                  Session[]
  createdTasks              Task[]                   @relation("TaskCreator")
  assignedTasks             Task[]                   @relation("TaskAssigner")
  taskComments              TaskComment[]
  taskActivities            TaskActivity[]
  createdClients            Client[]                 @relation("ClientCreator")
  clientActivities          ClientActivity[]
  createdRentals            Rental[]                 @relation("RentalCreator")
  rentalActivities          RentalActivity[]
  createdDocuments          Document[]               @relation("DocumentCreator")
  uploadedVersions          DocumentVersion[]        @relation("DocumentVersionUploader")
  documentActivities        DocumentActivity[]
  createdInvoices           Invoice[]                @relation("InvoiceCreator")
  recordedPayments          Payment[]                @relation("PaymentRecorder")
  requestedSignatures       SignatureRequest[]       @relation("SignatureRequester")
  invoiceActivities         InvoiceActivity[]
  signatureEvents           SignatureEvent[]
  portalInvitations         ClientPortalInvitation[] @relation("PortalInviter")
  approvalRequests          ClientApprovalRequest[]  @relation("ApprovalRequester")
  timezone                  String?
  createdCalendarEvents     CalendarEvent[]          @relation("CalendarEventCreator")
  notifications             Notification[]
  notificationPreferences   NotificationPreference[]
  createdLedgerTransactions LedgerTransaction[]      @relation("LedgerCreator")
  voidedLedgerTransactions  LedgerTransaction[]      @relation("LedgerVoider")
  savedReportFilters        SavedReportFilter[]
  createdTrainingSessions   TrainingSession[]        @relation("TrainingSessionCreator")
  createdMaintenance        MaintenanceRecord[]      @relation("MaintenanceCreator")

  @@unique([organizationId, email])
  @@index([organizationId, active])
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EquipmentCategory {
  id             String                 @id @default(uuid())
  organizationId String
  name           String
  description    String?
  active         Boolean                @default(true)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  equipment      Equipment[]
  packageItems   EquipmentPackageItem[]

  @@unique([organizationId, name])
  @@index([organizationId, active])
}

model EquipmentLocation {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  description    String?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  equipment      Equipment[]

  @@unique([organizationId, name])
  @@index([organizationId, active])
}

model Equipment {
  id                   String                @id @default(uuid())
  organizationId       String
  assetNumber          String
  name                 String
  description          String?
  categoryId           String?
  manufacturer         String?
  model                String?
  serialNumber         String?
  status               EquipmentStatus       @default(AVAILABLE)
  condition            EquipmentCondition    @default(GOOD)
  purchaseDate         DateTime?
  purchaseCost         Decimal?              @db.Decimal(12, 2)
  replacementValue     Decimal?              @db.Decimal(12, 2)
  defaultRentalRate    Decimal?              @db.Decimal(12, 2)
  rateUnit             RentalRateUnit?
  rentable             Boolean               @default(true)
  active               Boolean               @default(true)
  locationId           String?
  notes                String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  category             EquipmentCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  location             EquipmentLocation?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  rentalItems          RentalItem[]
  documentRelations    DocumentRelation[]
  ledgerTransactions   LedgerTransaction[]
  meterUnit            MeterUnit?
  maintenanceRecords   MaintenanceRecord[]
  maintenanceSchedules MaintenanceSchedule[]
  meterReadings        MeterReading[]

  @@unique([organizationId, assetNumber])
  @@index([organizationId, status, active, rentable])
  @@index([organizationId, categoryId])
  @@index([organizationId, locationId])
}

model Rental {
  id                     String              @id @default(uuid())
  organizationId         String
  rentalNumber           String
  clientId               String?
  clientContactId        String?
  projectId              String?
  status                 RentalStatus        @default(DRAFT)
  reservationStart       DateTime
  reservationEnd         DateTime
  checkedOutAt           DateTime?
  returnedAt             DateTime?
  preparedByEmployeeId   String?
  checkedOutByEmployeeId String?
  receivedByEmployeeId   String?
  customerReference      String?
  pickupNotes            String?
  returnNotes            String?
  internalNotes          String?
  portalVisible          Boolean             @default(false)
  createdByUserId        String
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  organization           Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  documentRelations      DocumentRelation[]
  client                 Client?             @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientContact          ClientContact?      @relation(fields: [clientContactId], references: [id], onDelete: SetNull)
  project                Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  preparedBy             Employee?           @relation("RentalPreparer", fields: [preparedByEmployeeId], references: [id], onDelete: SetNull)
  checkedOutBy           Employee?           @relation("RentalCheckoutEmployee", fields: [checkedOutByEmployeeId], references: [id], onDelete: SetNull)
