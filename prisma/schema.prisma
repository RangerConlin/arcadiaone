  @@index([organizationId, invoiceId, createdAt])
}

model SignatureRequest {
  id                String                  @id @default(uuid())
  organizationId    String
  documentId        String
  documentVersionId String
  signedDocumentId  String?
  provider          SignatureProviderType   @default(LOCAL)
  externalRequestId String?
  title             String
  message           String?
  status            SignatureRequestStatus  @default(DRAFT)
  requestedByUserId String
  expiresAt         DateTime?
  sentAt            DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?
  auditReference    String?
  providerMetadata  Json?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  organization      Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  document          Document                @relation("SignatureSourceDocument", fields: [documentId], references: [id], onDelete: Restrict)
  documentVersion   DocumentVersion         @relation(fields: [documentVersionId], references: [id], onDelete: Restrict)
  signedDocument    Document?               @relation("SignatureSignedDocument", fields: [signedDocumentId], references: [id], onDelete: SetNull)
  requestedBy       User                    @relation("SignatureRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  signers           SignatureSigner[]
  fields            SignatureField[]
  events            SignatureEvent[]
  webhookEvents     SignatureWebhookEvent[]

  @@unique([provider, externalRequestId])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, documentId])
}

model SignatureSigner {
  id                 String                @id @default(uuid())
  organizationId     String
  signatureRequestId String
  clientContactId    String?
  employeeId         String?
  name               String
  email              String
  roleTitle          String?
  signingOrder       Int?
  status             SignatureSignerStatus @default(PENDING)
  externalSignerId   String?
  signedAt           DateTime?
  declinedAt         DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  organization       Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  signatureRequest   SignatureRequest      @relation(fields: [signatureRequestId], references: [id], onDelete: Cascade)
  clientContact      ClientContact?        @relation(fields: [clientContactId], references: [id], onDelete: SetNull)
  employee           Employee?             @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  fields             SignatureField[]

  @@index([organizationId, signatureRequestId, signingOrder])
}

model SignatureField {
  id                 String             @id @default(uuid())
  signatureRequestId String
  signerId           String
  pageNumber         Int
  type               SignatureFieldType
  x                  Decimal            @db.Decimal(8, 3)
  y                  Decimal            @db.Decimal(8, 3)
  width              Decimal            @db.Decimal(8, 3)
  height             Decimal            @db.Decimal(8, 3)
  required           Boolean            @default(true)
  signatureRequest   SignatureRequest   @relation(fields: [signatureRequestId], references: [id], onDelete: Cascade)
  signer             SignatureSigner    @relation(fields: [signerId], references: [id], onDelete: Cascade)

  @@index([signatureRequestId, signerId])
}

model SignatureEvent {
  id                 String             @id @default(uuid())
  organizationId     String
  signatureRequestId String
  userId             String?
  type               SignatureEventType
  detail             String?
  providerEventId    String?
  createdAt          DateTime           @default(now())
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  signatureRequest   SignatureRequest   @relation(fields: [signatureRequestId], references: [id], onDelete: Cascade)
  user               User?              @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([signatureRequestId, providerEventId])
  @@index([organizationId, signatureRequestId, createdAt])
}

model SignatureWebhookEvent {
  id                 String           @id @default(uuid())
  signatureRequestId String
  providerEventId    String
  receivedAt         DateTime         @default(now())
  processedAt        DateTime?
  signatureRequest   SignatureRequest @relation(fields: [signatureRequestId], references: [id], onDelete: Cascade)

  @@unique([signatureRequestId, providerEventId])
}

