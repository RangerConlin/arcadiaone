}

/// Standalone events only. Dates owned by other modules (tasks, rentals, invoices,
/// qualifications, ...) are aggregated at read time and are never copied here.
/// All-day events store their first/last calendar day as UTC midnight (date-only);
/// timed events store UTC instants.
model CalendarEvent {
  id                 String                  @id @default(uuid())
  organizationId     String
  title              String
  description        String?
  startAt            DateTime
  endAt              DateTime?
  allDay             Boolean                 @default(false)
  location           String?
  visibility         CalendarEventVisibility @default(ORGANIZATION)
  status             CalendarEventStatus     @default(SCHEDULED)
  createdByUserId    String
  updatedByUserId    String?
  assignedEmployeeId String?
  projectId          String?
  clientId           String?
  cancelledAt        DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  organization       Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy          User                    @relation("CalendarEventCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  assignedEmployee   Employee?               @relation(fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  project            Project?                @relation(fields: [projectId], references: [id], onDelete: SetNull)
  client             Client?                 @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([organizationId, startAt])
  @@index([organizationId, assignedEmployeeId, startAt])
  @@index([organizationId, projectId])
  @@index([organizationId, createdByUserId])
}

enum NotificationCategory {
  TASK_ASSIGNMENTS
  TASK_REMINDERS
  QUALIFICATIONS
  RENTALS
  INVOICES
  SIGNATURES
  APPROVALS
  PROJECT_UPDATES
  DOCUMENTS
  TRAINING
  MAINTENANCE
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_DUE_TOMORROW
  TASK_DUE_SOON
  TASK_OVERDUE
  QUALIFICATION_EXPIRING
  QUALIFICATION_EXPIRED
  RENTAL_DUE_SOON
  RENTAL_OVERDUE
  INVOICE_DUE_SOON
  INVOICE_OVERDUE
  SIGNATURE_REQUESTED
  APPROVAL_REQUESTED
  CLIENT_RESPONSE_RECEIVED
  PROJECT_MEMBER_ADDED
  DOCUMENT_SHARED
  TRAINING_ENROLLED
  TRAINING_SESSION_REMINDER
  TRAINING_SESSION_CHANGED
  TRAINING_VERIFICATION_NEEDED
  MAINTENANCE_DUE_SOON
  MAINTENANCE_OVERDUE
  MAINTENANCE_COMPLETED
  EQUIPMENT_UNAVAILABLE
}

enum NotificationEntityType {
  TASK
  PROJECT
  EMPLOYEE_QUALIFICATION
  RENTAL
  INVOICE
  SIGNATURE_REQUEST
  CLIENT_APPROVAL_REQUEST
  DOCUMENT
  TRAINING_SESSION
  TRAINING_RECORD
  MAINTENANCE_RECORD
  EQUIPMENT
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
}

/// Internal-user notification. A communication record only: reading or dismissing
/// one never changes the underlying business record. Client portal users are not
/// recipients of this model.
model Notification {
  id                String                  @id @default(uuid())
  organizationId    String
  userId            String
  type              NotificationType
  category          NotificationCategory
  title             String
  message           String
  relatedEntityType NotificationEntityType?
  relatedEntityId   String?
  /// Generated server-side from trusted application routes; never from user input.
  actionUrl         String?
  /// Idempotency key for condition-based notifications, unique per recipient.
  dedupeKey         String?
  readAt            DateTime?
  dismissedAt       DateTime?
  archivedAt        DateTime?
  createdAt         DateTime                @default(now())
  organization      Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, archivedAt, readAt, createdAt])
  @@index([organizationId, createdAt])
}

/// A missing row means the channel default applies (IN_APP on, others off).
model NotificationPreference {
  id             String               @id @default(uuid())
  organizationId String
  userId         String
  category       NotificationCategory
  channel        NotificationChannel  @default(IN_APP)
  enabled        Boolean              @default(true)
  updatedAt      DateTime             @updatedAt
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, channel])
  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Ledger, reporting and audit
// ---------------------------------------------------------------------------

enum LedgerTransactionType {
  INCOME
  EXPENSE
  ADJUSTMENT
}

/// Operational categories only; there is no chart of accounts.
model LedgerCategory {
  id             String                 @id @default(uuid())
  organizationId String
  name           String
  /// Optional hint so pickers can narrow the list; a category never forces a transaction type.
  type           LedgerTransactionType?
  description    String?
  active         Boolean                @default(true)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  transactions   LedgerTransaction[]

  @@unique([organizationId, name])
  @@index([organizationId, active])
}

/// A recorded business transaction. Amounts are exact decimals. INCOME and EXPENSE amounts are
/// positive; an ADJUSTMENT is signed (positive raises, negative lowers net recorded activity).
/// Transactions are voided, never deleted.
model LedgerTransaction {
  id                  String                @id @default(uuid())
  organizationId      String
  transactionNumber   String?
  type                LedgerTransactionType
  transactionDate     DateTime              @db.Date
  description         String
  amount              Decimal               @db.Decimal(14, 2)
  currency            String                @default("USD") @db.VarChar(3)
  categoryId          String?
  clientId            String?
  projectId           String?
  rentalId            String?
  invoiceId           String?
  paymentId           String?               @unique
  equipmentId         String?
  reference           String?
  notes               String?
  createdByUserId     String
  voidedAt            DateTime?
  voidedByUserId      String?
  voidReason          String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  organization        Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  category            LedgerCategory?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  client              Client?               @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project             Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  rental              Rental?               @relation(fields: [rentalId], references: [id], onDelete: SetNull)
  invoice             Invoice?              @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  payment             Payment?              @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  equipment           Equipment?            @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  createdBy           User                  @relation("LedgerCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  voidedBy            User?                 @relation("LedgerVoider", fields: [voidedByUserId], references: [id], onDelete: SetNull)
  maintenanceRecordId String?               @unique
  maintenanceRecord   MaintenanceRecord?    @relation(fields: [maintenanceRecordId], references: [id], onDelete: SetNull)

  @@unique([organizationId, transactionNumber])
  @@index([organizationId, transactionDate])
  @@index([organizationId, type, transactionDate])
  @@index([organizationId, categoryId])
  @@index([organizationId, clientId])
  @@index([organizationId, projectId])
  @@index([organizationId, rentalId])
  @@index([organizationId, invoiceId])
}

/// Append-only. A database trigger rejects UPDATE and DELETE (see the migration). Actor ids are
/// plain values rather than foreign keys so deleting or renaming a user never rewrites history.
model AuditEvent {
  id                String       @id @default(uuid())
  organizationId    String
  actorUserId       String?
  actorPortalUserId String?
  /// Human label captured at the time (email or portal email) so the log stays readable.
  actorLabel        String?
  action            String
  entityType        String
  entityId          String?
  outcome           String       @default("SUCCESS")
  summary           String
  metadata          Json?
  ipAddress         String?
  userAgent         String?
  occurredAt        DateTime     @default(now())
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, occurredAt(sort: Desc)])
  @@index([organizationId, entityType, entityId])
  @@index([organizationId, action, occurredAt(sort: Desc)])
  @@index([organizationId, actorUserId, occurredAt(sort: Desc)])
}

/// A named set of report filters (whitelisted query parameters), private to its owner.
model SavedReportFilter {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  reportId       String
  name           String
  filters        Json
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, reportId, name])
  @@index([organizationId, userId, reportId])
}

// ---------------------------------------------------------------------------
// Training
// ---------------------------------------------------------------------------

enum TrainingDeliveryMethod {
  IN_PERSON
  VIRTUAL
  ONLINE_SELF_PACED
  BLENDED
  OTHER
}

enum TrainingSessionStatus {
  PLANNED
  OPEN
  COMPLETED
  CANCELLED
}

enum TrainingEnrollmentStatus {
  ENROLLED
  ATTENDED
  COMPLETED
  NO_SHOW
  CANCELLED
}

/// What completing a course may do to qualifications. NONE is the conservative default.
enum TrainingQualificationEffect {
  NONE
  SUGGEST
  CREATE_UNVERIFIED
  CREATE_VERIFIED
}

/// A reusable course definition. Not a qualification: it records what can be taken, not what is held.
model TrainingCourse {
  id                   String                        @id @default(uuid())
  organizationId       String
  name                 String
  code                 String?
  description          String?
  provider             String?
  defaultDurationHours Decimal?                      @db.Decimal(6, 2)
  deliveryMethod       TrainingDeliveryMethod?
  active               Boolean                       @default(true)
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt
  organization         Organization                  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  qualificationLinks   TrainingCourseQualification[]
  sessions             TrainingSession[]
  records              EmployeeTrainingRecord[]
  documentRelations    DocumentRelation[]

  @@unique([organizationId, name])
  @@unique([organizationId, code])
  @@index([organizationId, active])
}

model TrainingCourseQualification {
  id                  String                      @id @default(uuid())
  organizationId      String
  trainingCourseId    String
  qualificationTypeId String
  effect              TrainingQualificationEffect @default(SUGGEST)
  createdAt           DateTime                    @default(now())
  organization        Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  trainingCourse      TrainingCourse              @relation(fields: [trainingCourseId], references: [id], onDelete: Cascade)
  qualificationType   QualificationType           @relation(fields: [qualificationTypeId], references: [id], onDelete: Cascade)

  @@unique([trainingCourseId, qualificationTypeId])
  @@index([organizationId, qualificationTypeId])
}

model TrainingSession {
  id                String                @id @default(uuid())
  organizationId    String
  trainingCourseId  String
  titleOverride     String?
  startAt           DateTime
  endAt             DateTime?
  location          String?
  instructor        String?
  providerOverride  String?
  maxParticipants   Int?
  notes             String?
  status            TrainingSessionStatus @default(PLANNED)
  createdByUserId   String
  completedAt       DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  organization      Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  trainingCourse    TrainingCourse        @relation(fields: [trainingCourseId], references: [id], onDelete: Restrict)
  createdBy         User                  @relation("TrainingSessionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  enrollments       TrainingEnrollment[]
  documentRelations DocumentRelation[]

  @@index([organizationId, startAt])
  @@index([organizationId, status, startAt])
  @@index([trainingCourseId])
}

model TrainingEnrollment {
  id                      String                   @id @default(uuid())
  organizationId          String
  trainingSessionId       String
  employeeId              String
  status                  TrainingEnrollmentStatus @default(ENROLLED)
  completionDate          DateTime?                @db.Date
  hoursCompleted          Decimal?                 @db.Decimal(6, 2)
  score                   Decimal?                 @db.Decimal(6, 2)
  passed                  Boolean?
  notes                   String?
  employeeQualificationId String?
  enrolledByUserId        String
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  organization            Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  trainingSession         TrainingSession          @relation(fields: [trainingSessionId], references: [id], onDelete: Cascade)
  employee                Employee                 @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeQualification   EmployeeQualification?   @relation(fields: [employeeQualificationId], references: [id], onDelete: SetNull)

  @@unique([trainingSessionId, employeeId])
  @@index([organizationId, employeeId, status])
  @@index([organizationId, completionDate])
}

/// Training completed outside ArcadiaOne, or recorded without a scheduled session.
model EmployeeTrainingRecord {
  id                      String                 @id @default(uuid())
  organizationId          String
  employeeId              String
  trainingCourseId        String?
  courseName              String
  provider                String
  completionDate          DateTime               @db.Date
  hours                   Decimal?               @db.Decimal(6, 2)
  certificateNumber       String?
  notes                   String?
  verified                Boolean                @default(false)
  verifiedByUserId        String?
  verifiedAt              DateTime?
  rejectedAt              DateTime?
  rejectedByUserId        String?
  rejectionReason         String?
  employeeQualificationId String?
  submittedByUserId       String
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  organization            Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee                Employee               @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  trainingCourse          TrainingCourse?        @relation(fields: [trainingCourseId], references: [id], onDelete: SetNull)
  employeeQualification   EmployeeQualification? @relation(fields: [employeeQualificationId], references: [id], onDelete: SetNull)
  documentRelations       DocumentRelation[]

  @@index([organizationId, employeeId, completionDate])
  @@index([organizationId, verified, rejectedAt])
  @@index([organizationId, completionDate])
}

// ---------------------------------------------------------------------------
// Equipment maintenance
// ---------------------------------------------------------------------------

enum MaintenanceType {
  INSPECTION
  PREVENTIVE
  REPAIR
  DAMAGE
  CALIBRATION
  SOFTWARE_FIRMWARE
  OTHER
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  AWAITING_PARTS
  COMPLETED
  CANCELLED
}

enum InspectionResult {
  PASS
  FAIL
}

enum MeterUnit {
  HOURS
  MILES
  CYCLES
}

/// Work done to, or needed by, one piece of equipment. Distinct from Rental, which records who has it.
model MaintenanceRecord {
  id                     String               @id @default(uuid())
  organizationId         String
  equipmentId            String
  scheduleId             String?
  type                   MaintenanceType
  status                 MaintenanceStatus    @default(OPEN)
  openedAt               DateTime             @default(now())
  completedAt            DateTime?
  performedByEmployeeId  String?
  vendorName             String?
  description            String
  workPerformed          String?
  cost                   Decimal?             @db.Decimal(12, 2)
  meterReading           Decimal?             @db.Decimal(12, 1)
  nextServiceDate        DateTime?            @db.Date
  nextServiceMeter       Decimal?             @db.Decimal(12, 1)
  notes                  String?
  inspectionResult       InspectionResult?
  conditionFound         EquipmentCondition?
  /// Unavailability this record itself caused (MAINTENANCE or OUT_OF_SERVICE), for downtime reporting.
  equipmentStatusApplied EquipmentStatus?
  unavailableAt          DateTime?
  returnedToServiceAt    DateTime?
  createdByUserId        String
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  organization           Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  equipment              Equipment            @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  schedule               MaintenanceSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  performedBy            Employee?            @relation(fields: [performedByEmployeeId], references: [id], onDelete: SetNull)
  createdBy              User                 @relation("MaintenanceCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  documentRelations      DocumentRelation[]
  meterReadings          MeterReading[]
  ledgerTransaction      LedgerTransaction?

  @@index([organizationId, status, openedAt])
  @@index([organizationId, equipmentId, openedAt])
  @@index([organizationId, completedAt])
  @@index([organizationId, type])
}

/// A recurring service expectation for one asset, by date interval, meter interval, or both.
model MaintenanceSchedule {
  id                    String              @id @default(uuid())
  organizationId        String
  equipmentId           String
  type                  MaintenanceType
  title                 String?
  intervalDays          Int?
  intervalMonths        Int?
  intervalMeter         Decimal?            @db.Decimal(12, 1)
  lastServiceDate       DateTime?           @db.Date
  lastServiceMeter      Decimal?            @db.Decimal(12, 1)
  nextServiceDate       DateTime?           @db.Date
  nextServiceMeter      Decimal?            @db.Decimal(12, 1)
  responsibleEmployeeId String?
  active                Boolean             @default(true)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  organization          Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  equipment             Equipment           @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  responsibleEmployee   Employee?           @relation(fields: [responsibleEmployeeId], references: [id], onDelete: SetNull)
  records               MaintenanceRecord[]

  @@index([organizationId, active, nextServiceDate])
  @@index([organizationId, equipmentId])
}

/// A usage reading (hours, miles or cycles). The unit lives on Equipment.meterUnit; equipment with no unit has no meter.
model MeterReading {
  id                  String             @id @default(uuid())
  organizationId      String
  equipmentId         String
  reading             Decimal            @db.Decimal(12, 1)
  recordedAt          DateTime           @default(now())
  recordedByUserId    String
  maintenanceRecordId String?
  notes               String?
  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  equipment           Equipment          @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  maintenanceRecord   MaintenanceRecord? @relation(fields: [maintenanceRecordId], references: [id], onDelete: SetNull)

  @@index([organizationId, equipmentId, recordedAt(sort: Desc)])
}
