generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model SystemHealth {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
}

model Organization {
  id             String         @id @default(uuid())
  name           String         @unique
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  departments    Department[]
  positions      Position[]
  employees      Employee[]
  users          User[]
  projects       Project[]
  tasks          Task[]
  taskComments   TaskComment[]
  taskActivities TaskActivity[]
}

model Department {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  description    String?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employees      Employee[]

  @@unique([organizationId, name])
  @@index([organizationId, active])
}

model Position {
  id             String       @id @default(uuid())
  organizationId String
  title          String
  description    String?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employees      Employee[]

  @@unique([organizationId, title])
  @@index([organizationId, active])
}

model Employee {
  id                 String           @id @default(uuid())
  organizationId     String
  employeeNumber     String?
  firstName          String
  preferredName      String?
  middleName         String?
  lastName           String
  suffix             String?
  workEmail          String?
  personalEmail      String?
  workPhone          String?
  mobilePhone        String?
  departmentId       String?
  positionId         String?
  supervisorId       String?
  employmentStatus   EmploymentStatus @default(ACTIVE)
  hireDate           DateTime?
  separationDate     DateTime?
  notes              String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  department         Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  position           Position?        @relation(fields: [positionId], references: [id], onDelete: SetNull)
  supervisor         Employee?        @relation("EmployeeSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  directReports      Employee[]       @relation("EmployeeSupervisor")
  user               User?
  projectMemberships ProjectMember[]
  assignedTasks      Task[]           @relation("TaskAssignee")

  @@unique([organizationId, employeeNumber])
  @@index([organizationId, employmentStatus])
  @@index([departmentId])
  @@index([positionId])
  @@index([supervisorId])
  @@index([lastName, firstName])
}

model User {
  id              String         @id @default(uuid())
  organizationId  String
  employeeId      String?        @unique
  email           String
  name            String
  role            UserRole       @default(EMPLOYEE)
  active          Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee        Employee?      @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  managedProjects Project[]      @relation("ProjectManager")
  createdTasks    Task[]         @relation("TaskCreator")
  assignedTasks   Task[]         @relation("TaskAssigner")
  taskComments    TaskComment[]
  taskActivities  TaskActivity[]

  @@unique([organizationId, email])
  @@index([organizationId, role, active])
}

model Project {
  id             String             @id @default(uuid())
  organizationId String
  name           String
  description    String?
  status         ProjectStatus      @default(ACTIVE)
  managerUserId  String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  manager        User?              @relation("ProjectManager", fields: [managerUserId], references: [id], onDelete: SetNull)
  members        ProjectMember[]
  milestones     ProjectMilestone[]
  tasks          Task[]

  @@unique([organizationId, name])
  @@index([organizationId, status])
}

model ProjectMember {
  id         String   @id @default(uuid())
  projectId  String
  employeeId String
  roleName   String?
  createdAt  DateTime @default(now())
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([projectId, employeeId])
  @@index([employeeId])
}

model ProjectMilestone {
  id          String    @id @default(uuid())
  projectId   String
  name        String
  description String?
  dueDate     DateTime?
  completedAt DateTime?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks       Task[]

  @@unique([projectId, name])
  @@index([projectId, sortOrder])
}

model Task {
  id                   String              @id @default(uuid())
  organizationId       String
  projectId            String?
  parentTaskId         String?
  milestoneId          String?
  title                String
  description          String?
  status               TaskStatus          @default(TODO)
  priority             TaskPriority        @default(NORMAL)
  dueDate              DateTime?
  startDate            DateTime?
  completedAt          DateTime?
  createdByUserId      String
  assignedToEmployeeId String?
  assignedByUserId     String?
  sortOrder            Int                 @default(0)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  organization         Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project              Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  milestone            ProjectMilestone?   @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  parentTask           Task?               @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: SetNull)
  subtasks             Task[]              @relation("TaskSubtasks")
  createdBy            User                @relation("TaskCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  assignedTo           Employee?           @relation("TaskAssignee", fields: [assignedToEmployeeId], references: [id], onDelete: SetNull)
  assignedBy           User?               @relation("TaskAssigner", fields: [assignedByUserId], references: [id], onDelete: SetNull)
  checklistItems       TaskChecklistItem[]
  comments             TaskComment[]
  activities           TaskActivity[]

  @@index([organizationId, status, dueDate])
  @@index([organizationId, assignedToEmployeeId, status])
  @@index([projectId, status])
  @@index([milestoneId])
  @@index([parentTaskId])
}

model TaskChecklistItem {
  id        String   @id @default(uuid())
  taskId    String
  text      String
  completed Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, sortOrder])
}

model TaskComment {
  id             String       @id @default(uuid())
  organizationId String
  taskId         String
  userId         String
  content        String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  task           Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([organizationId, taskId, createdAt])
}

model TaskActivity {
  id             String           @id @default(uuid())
  organizationId String
  taskId         String
  userId         String
  type           TaskActivityType
  detail         String?
  createdAt      DateTime         @default(now())
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  task           Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([organizationId, taskId, createdAt])
}

enum UserRole {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TaskActivityType {
  CREATED
  UPDATED
  STATUS_CHANGED
  ASSIGNEE_CHANGED
  DUE_DATE_CHANGED
  COMPLETED
  REOPENED
  COMMENT_ADDED
  CHECKLIST_CHANGED
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
  LEAVE
  TERMINATED
}
